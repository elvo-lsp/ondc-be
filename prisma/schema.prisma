// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RiderStatus {
  PROFILE_PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

/// Independent of RiderStatus: a rejected document asks the rider to re-upload
/// that one, it does not reject the rider.
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A logistics organisation - the tenant boundary. Admins, vendors and riders
/// each belong to exactly one. Seeded, never created at runtime; one today.
model Partner {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins       AdminUser[]
  vendors      Vendor[]
  vendorChains VendorChain[]
  riders       Rider[]
}

/// An admin panel login. Seeded only - no self-signup, no roles yet.
model AdminUser {
  id           String  @id @default(uuid())
  partnerId    String
  partner      Partner @relation(fields: [partnerId], references: [id])
  name         String
  email        String  @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewedRiders      Rider[]         @relation("RiderReviewedBy")
  createdVendors      Vendor[]        @relation("VendorCreatedBy")
  createdVendorChains VendorChain[]   @relation("VendorChainCreatedBy")
  reviewedDocuments   RiderDocument[] @relation("DocumentReviewedBy")

  @@index([partnerId])
}

/// A brand grouping several Vendor rows under one owner, e.g. "Burger King"
/// grouping its Andheri and Powai outlets. Optional - most vendors are
/// independent and have no chain. Lives inside a partner, like Vendor; a chain
/// belongs to exactly one partner and cannot group vendors across partners.
model VendorChain {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  name String

  createdByAdminId String?
  createdByAdmin   AdminUser? @relation("VendorChainCreatedBy", fields: [createdByAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendors Vendor[]

  @@unique([partnerId, name])
  @@index([partnerId])
}

/// A seller/store whose deliveries a partner's riders serve. NOT a tenant -
/// vendors live inside a partner.
model Vendor {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  /// Groups this vendor under a brand - see VendorChain. Null for an
  /// independent vendor, which is the common case.
  chainId String?
  chain   VendorChain? @relation(fields: [chainId], references: [id])

  name         String
  /// Free-form business-assigned reference (e.g. an internal store code).
  /// Optional and unique per partner when set - onboarding shouldn't block on
  /// a code the admin doesn't have yet.
  code         String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  address      String?
  isActive     Boolean @default(true)

  /// Where a rider must be to punch in at this vendor - see docs/admin/README.md.
  /// All three are optional at creation and set later via edit; latitude and
  /// longitude are required together, and geofenceRadiusMeters only makes
  /// sense once a location is set.
  latitude             Float?
  longitude            Float?
  geofenceRadiusMeters Int?

  /// What this vendor needs a rider assigned to it to bring. Independent flags,
  /// not one enum, because a future third requirement (e.g. cold storage)
  /// should be an additive column, not a rename of every existing value.
  needsRiders   Boolean @default(true)
  needsVehicles Boolean @default(false)

  /// Nullable for the same reason as Rider.reviewedByAdminId: an admin can be
  /// removed without taking their vendors with them, and a vendor created by a
  /// script rather than a person has no admin to point at.
  createdByAdminId String?
  createdByAdmin   AdminUser? @relation("VendorCreatedBy", fields: [createdByAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riders   Rider[]
  contacts VendorContact[]

  @@unique([partnerId, name])
  @@unique([partnerId, code])
  @@index([partnerId])
  @@index([chainId])
}

/// A vendor's point of contact - name and role, up to 10 per vendor (enforced
/// by the DTO, not here). Every write replaces the full set rather than diffing
/// individual rows, since the admin panel always submits the vendor's complete
/// current list - see AdminVendorsService.
model VendorContact {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  name        String
  designation String?

  createdAt DateTime @default(now())

  @@index([vendorId])
}

model Rider {
  id     String      @id @default(uuid())
  name   String
  /// Always lowercased - see RiderAuthService.normaliseEmail. The unique index is
  /// case-sensitive, so normalising on write is what makes one address one rider.
  email  String      @unique
  /// Always E.164 - see RiderAuthService.normalisePhone. Same reasoning: the
  /// validator accepts several formats for one number, the index does not.
  phone  String      @unique
  status RiderStatus @default(PROFILE_PENDING)

  /// Set at signup from DEFAULT_PARTNER_CODE. Scopes every admin query.
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  /// Which seller this rider serves. Assigned by an admin at approval, so it
  /// is null for anyone not yet approved.
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  reviewedAt        DateTime?
  reviewedByAdminId String?
  reviewedByAdmin   AdminUser? @relation("RiderReviewedBy", fields: [reviewedByAdminId], references: [id])
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   RiderProfile?
  documents RiderDocument[]

  @@index([partnerId, status])
  @@index([vendorId])
}

model RiderProfile {
  id      String @id @default(uuid())
  riderId String @unique
  rider   Rider  @relation(fields: [riderId], references: [id])

  dateOfBirth      DateTime?
  temporaryAddress String?
  permanentAddress String?

  /// AES-256-GCM (iv || authTag || ciphertext). Never stored in plaintext -
  /// see docs/infra/aadhaar.md.
  aadhaarCiphertext Bytes?
  /// HMAC of the number, for duplicate detection - you cannot query ciphertext.
  aadhaarHash       String? @unique
  aadhaarLast4      String?

  profileCompletedAt   DateTime?
  documentsCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Rows are never deleted or overwritten - a re-upload of the same `type` inserts
/// a new row and supersedes the old, so the review history survives.
/// See docs/rider/onboarding-api.md.
model RiderDocument {
  id         String   @id @default(uuid())
  riderId    String
  rider      Rider    @relation(fields: [riderId], references: [id])
  type       String
  filePath   String
  uploadedAt DateTime @default(now())

  /// Admin review of this specific document.
  status            DocumentStatus @default(PENDING)
  rejectionComment  String?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  reviewedByAdmin   AdminUser?     @relation("DocumentReviewedBy", fields: [reviewedByAdminId], references: [id])

  /// Null means this is the row that counts for completeness and review; non-null
  /// is history and must not be re-decided.
  supersededAt   DateTime?
  /// The replacement. Deliberately **not** unique: an upload retires every live row
  /// of its type in one statement, so a race that left two behind self-heals. A
  /// unique constraint would make that statement fail and strand a row live.
  supersededById String?
  supersededBy   RiderDocument?  @relation("DocumentSupersedes", fields: [supersededById], references: [id])
  supersedes     RiderDocument[] @relation("DocumentSupersedes")

  @@index([riderId])
  /// Backs the "current document per type" lookup every completeness check uses.
  @@index([riderId, type, supersededAt])
  /// Postgres does not index a foreign key for you; walked to follow a rejected
  /// document forward to its replacement.
  @@index([supersededById])
}
