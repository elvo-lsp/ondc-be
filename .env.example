# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://ondc:ondc@localhost:5432/ondc_be?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# This LSP's identity on the ONDC network
SUBSCRIBER_ID="lsp.example.com"
SUBSCRIBER_URL="https://lsp.example.com/ondc"
UK_ID="UKID1"

# ed25519 keypair (base64), generate per docs/ondc/auth.md
SIGNING_PRIVATE_KEY=""
SIGNING_PUBLIC_KEY=""

# ONDC registry
REGISTRY_URL="https://staging.registry.ondc.org/ondc"
ONDC_ENVIRONMENT="staging"

# Dev-only: lets inbound signature verification pass locally without a reachable registry
# entry for this subscriber. Only ever consulted when ONDC_ENVIRONMENT is not prod/production
# and the real registry lookup fails - see docs/ondc/auth.md. Leave unset in any real deploy.
DEV_TRUSTED_SUBSCRIBER_ID=""
DEV_TRUSTED_SUBSCRIBER_PUBLIC_KEY=""

PORT=3000
