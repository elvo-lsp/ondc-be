PORT=3000

# preprod: https://preprod.registry.ondc.org/ondc | prod: https://registry.ondc.org/ondc
ONDC_REGISTRY_URL=https://staging.registry.ondc.org/ondc
ONDC_DOMAIN=nic2004:60232
ONDC_SUBSCRIBER_ID=
ONDC_SUBSCRIBER_UNIQUE_KEY_ID=
ONDC_SIGNING_PRIVATE_KEY=

DATABASE_URL="postgresql://ondc:ondc@localhost:5432/ondc_be?schema=public"
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me

# Not the same value as JWT_SECRET - a leaked rider secret must not mint admin tokens.
ADMIN_JWT_SECRET=change-me-admin

DEFAULT_PARTNER_CODE=elvo
SEED_ADMIN_EMAIL=admin@elvo.local
SEED_ADMIN_PASSWORD=change-me

# 32 bytes hex, not rotatable in place - docs/infra/aadhaar.md
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AADHAAR_ENCRYPTION_KEY=
AADHAAR_HASH_PEPPER=

ADMIN_PANEL_ORIGIN=http://localhost:3001
