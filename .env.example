PORT=3000

# ONDC registry base URL used for /lookup (verifying incoming requests)
# staging: https://staging.registry.ondc.org/ondc
# preprod: https://preprod.registry.ondc.org/ondc
# prod:    https://registry.ondc.org/ondc
ONDC_REGISTRY_URL=https://staging.registry.ondc.org/ondc

# Domain code for logistics, used when looking up a sender's key in the registry
ONDC_DOMAIN=nic2004:60232

# Your own participant identity - needed later for signing outbound requests (/on_search etc.),
# not used by inbound verification yet
ONDC_SUBSCRIBER_ID=
ONDC_SUBSCRIBER_UNIQUE_KEY_ID=
ONDC_SIGNING_PRIVATE_KEY=

DATABASE_URL="postgresql://ondc:ondc@localhost:5432/ondc_be?schema=public"

JWT_SECRET=change-me

REDIS_URL=redis://localhost:6379